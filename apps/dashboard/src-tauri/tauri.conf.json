{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ThreadRecap",
  "version": "0.1.0",
  "identifier": "studio.chenx.threadrecap",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ThreadRecap",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 640,
        "center": true,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "icon": ["icons/icon.ico"],
    "shortDescription": "Live Codex session recaps",
    "longDescription": "A lightweight companion dashboard for ThreadRecap and Codex sessions.",
    "copyright": "Copyright © 2026 ChenXStudio"
  }
}
