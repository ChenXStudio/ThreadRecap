{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/hooks/run-hook.sh\"",
            "commandWindows": "& (Join-Path -Path $env:PLUGIN_ROOT -ChildPath 'hooks/run-hook.ps1')",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/hooks/run-hook.sh\"",
            "commandWindows": "& (Join-Path -Path $env:PLUGIN_ROOT -ChildPath 'hooks/run-hook.ps1')",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "\"$PLUGIN_ROOT/hooks/run-hook.sh\"",
            "commandWindows": "& (Join-Path -Path $env:PLUGIN_ROOT -ChildPath 'hooks/run-hook.ps1')",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
